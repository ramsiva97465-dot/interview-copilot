{
  "name": "meeting-bot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MeetFloo AI Meeting Bot Monorepo",
  "workspaces": [
    "admin-panel",
    "landing-page",
    "natively-cluely-ai-assistant"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=admin-panel",
    "dev:landing": "npm run dev --workspace=landing-page",
    "dev:desktop": "npm run app:dev --workspace=natively-cluely-ai-assistant",
    "build:admin": "npm run build --workspace=admin-panel",
    "build:landing": "npm run build --workspace=landing-page",
    "build:desktop": "npm run app:build --workspace=natively-cluely-ai-assistant"
  }
}
